# ---------------------------------------------------------------------------
# 绝对不能提交的东西
# ---------------------------------------------------------------------------
# 这些一旦进了公开仓库就撤不回来：GitHub 保留历史，别人可能已经克隆或抓取过。
# 在这里漏一个，等于永久泄露。

# 真实配置：含 API Key、SECRET_KEY（用它可解密所有人的 Key）、邀请码
.env
.env.*
!.env.example

# 运行时数据：账号库、密码哈希、对话记录、上传的图纸、解析缓存
data/

# 完整备份包：里面同样含账号库，是第二份泄露源
backups/
*.zip

# 本地个人词表：里面是人名、公司名、机器名，只用于发布前自检
scripts/_personal_terms.txt
scripts/_net_check.py
scripts/_push_routes.py
scripts/_find_git_mirror.py
scripts/_find_git_version.py
scripts/_install_git.py
scripts/_personal_scan.py

# ---------------------------------------------------------------------------
# 环境与构建产物
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---------------------------------------------------------------------------
# 编辑器与系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

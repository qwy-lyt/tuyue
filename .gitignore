# ---------------------------------------------------------------------------
# 绝对不能提交的东西
# ---------------------------------------------------------------------------
# 这些一旦进了公开仓库就撤不回来：GitHub 保留历史，别人可能已经克隆或抓取过。
# 在这里漏一个，等于永久泄露。

# 真实配置：含 API Key、SECRET_KEY（用它可解密所有人的 Key）、邀请码
.env
.env.*
!.env.example

# 运行时数据：账号库、密码哈希、对话记录、上传的图纸、解析缓存
data/

# 完整备份包：里面同样含账号库，是第二份泄露源
backups/
*.zip

# 本机运维笔记：记录这台机器上这个实例的具体情况（地址、路径、账号名）
# 公开仓库里不需要，也不该有
运维笔记.md

# 迁移说明：写给另一台机器上的助手看，同样含本机路径与账号名
迁移说明.md

# 发布前的本地自检工具：用到个人词表和本机路径，只在自己机器上跑
scripts/_personal_terms.txt
scripts/_personal_scan.py
scripts/_privacy_audit.py

# ---------------------------------------------------------------------------
# 环境与构建产物
# ---------------------------------------------------------------------------
# 第三方可执行文件（cloudflared 等），体积大且与平台相关，不该进仓库
bin/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---------------------------------------------------------------------------
# 编辑器与系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

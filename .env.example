# ---------------------------------------------------------------------------
# 复制这个文件为 .env，然后填入你自己的配置。.env 不会被提交到 git。
# ---------------------------------------------------------------------------

# 助手的名字。会用在侧栏标题、浏览器标签页、以及回答旁的头像上。
# 头像取名字的第一个字，所以建议用中文短名。
APP_NAME=图阅

# 引导邀请码。第一个账号用它注册，注册者自动成为管理员。
# 这个码不限使用次数：它是你自己的码，用完就进不去只是添堵。
# 想关闭自助注册就在管理后台把它吊销，或者把这里留空。
INVITE_CODE=换成一个只有你知道的字符串

# 以下三项是「默认值」。每个人实际用的是自己在网页「设置」里填的，
# 这里配的只是各人没填时的兜底。
#
# 已废弃：不再共用同一个 Key，各人用自己的。留着仅供 checkkey.py 诊断接口用。
DEEPSEEK_API_KEY=

# AI 接口地址。任何 OpenAI 兼容的服务都可以填这里，改完重启即生效。
# DeepSeek:  https://api.deepseek.com
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
# OpenAI:    https://api.openai.com/v1
AI_BASE_URL=https://api.deepseek.com

# 模型名。视觉任务需要支持图片输入的模型。
AI_MODEL=deepseek-flash

# 系统提示词，决定 AI 的角色和回答风格
SYSTEM_PROMPT=你是一个专业的工程文档助手，擅长阅读 PDF 文档和 CAD 图纸。回答时请基于用户上传的文件内容，引用具体的数据、标注和图层信息。如果文件中缺少回答所需的信息，请直接说明，不要臆测。

# ---------------------------------------------------------------------------
# 以下为可调参数，一般不用改
# ---------------------------------------------------------------------------

# 单轮对话最多附带几张图纸/页面图片。DeepSeek 请求体上限 48 MiB，别设太大。
MAX_IMAGES_PER_TURN=6

# 图片最长边像素。图纸类图片低于 1500 会看不清标注文字。
IMAGE_MAX_PX=1800

# JPEG 压缩质量，1-100。图纸线条多，低于 75 会糊。
IMAGE_JPEG_QUALITY=82

# 图纸渲染用的中文字体。留空则自动从系统字体里挑（优先黑体 simhei.ttf）。
# 不指定的话中文标注在渲染图里会变成方框——AutoCAD 的 SHX 字体在渲染时会回退到
# Arial，而 Arial 没有中文字形。可填字体文件名或完整路径。
DRAWING_CJK_FONT=

# ODA File Converter 安装路径。留空则自动探测常见安装位置。
# 默认位置类似：C:\Program Files\ODA\ODAFileConverter 25.4.0\ODAFileConverter.exe
ODA_CONVERTER_PATH=

# 调用 AI 接口的超时时间（秒）
REQUEST_TIMEOUT=300

# ---------------------------------------------------------------------------
# 账号与网络
# ---------------------------------------------------------------------------

# 登录状态保留多少天
SESSION_DAYS=30

# 会话 Cookie 是否带 Secure 标志（只有 HTTPS 才需要）。
# 用 Radmin 隧道时隧道本身已加密，保持 false 即可。
# 一旦把服务暴露到公网，必须改成 true，并改用 HTTPS。
COOKIE_SECURE=false

# 单个上传文件的上限（MB）。对外开放时别设太大。
MAX_UPLOAD_MB=50

# 监听地址。127.0.0.1 只有本机能访问；0.0.0.0 允许 Radmin 等网络接入。
# 绑 0.0.0.0 之后一定要靠防火墙限制来源，用 run_radmin.bat 会自动处理。
HOST=127.0.0.1
PORT=8000

# 首次运行会自动生成，用于加密每个人的 API Key。
# 删掉会导致已保存的密钥无法解密（用户需要重新填写）。
# SECRET_KEY=
